<mxfile host="app.diagrams.net">
  <diagram id="activity-appointment" name="Schedule appointment">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Activity diagram: schedule an appointment (US-05) and record the consultation (US-07, US-06)" style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="0" width="980" height="30" as="geometry" />
        </mxCell>

        <mxCell id="laneR" value="Receptionist" style="swimlane;startSize=30;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="300" height="1400" as="geometry" />
        </mxCell>
        <mxCell id="laneS" value="System" style="swimlane;startSize=30;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="380" height="1400" as="geometry" />
        </mxCell>
        <mxCell id="laneD" value="Doctor" style="swimlane;startSize=30;html=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="40" width="300" height="1400" as="geometry" />
        </mxCell>

        <mxCell id="r_start" value="" style="ellipse;html=1;shape=startState;fillColor=#000000;strokeColor=#ff0000;" vertex="1" parent="laneR">
          <mxGeometry x="135" y="50" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="r_login" value="Log in" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneR">
          <mxGeometry x="50" y="110" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_search" value="Search for the patient" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneR">
          <mxGeometry x="50" y="180" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_select" value="Select doctor, date, time and reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneR">
          <mxGeometry x="50" y="250" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r_submit" value="Submit the booking" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneR">
          <mxGeometry x="50" y="360" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_adjust" value="Change the patient, doctor or slot" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneR">
          <mxGeometry x="50" y="640" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="r_refusal" value="Read the refusal reason" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneR">
          <mxGeometry x="50" y="820" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="s_role" value="Check that the role may book" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneS">
          <mxGeometry x="20" y="360" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s_dec_role" value="Role permitted?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneS">
          <mxGeometry x="60" y="430" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s_403" value="Refuse with 403" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneS">
          <mxGeometry x="250" y="440" width="110" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s_denied" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#ff0000;" vertex="1" parent="laneS">
          <mxGeometry x="290" y="520" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s_active" value="Check that patient and doctor are active" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneS">
          <mxGeometry x="20" y="530" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s_dec_active" value="Both active?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneS">
          <mxGeometry x="60" y="610" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s_slot" value="Check the doctor's slot" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneS">
          <mxGeometry x="20" y="710" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s_dec_slot" value="Slot already taken?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneS">
          <mxGeometry x="60" y="780" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s_save" value="Insert the appointment with status scheduled" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneS">
          <mxGeometry x="20" y="880" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s_note" value="Unique index on (doctor, slot start) where status = scheduled" style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=11;" vertex="1" parent="laneS">
          <mxGeometry x="240" y="875" width="125" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s_dec_insert" value="Insert succeeded?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="laneS">
          <mxGeometry x="60" y="970" width="120" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s_complete" value="Save the medical record and mark the appointment completed" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneS">
          <mxGeometry x="20" y="1240" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="s_end" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#ff0000;" vertex="1" parent="laneS">
          <mxGeometry x="105" y="1330" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="d_list" value="See the appointment in my list" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneD">
          <mxGeometry x="50" y="980" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d_consult" value="Conduct the consultation" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneD">
          <mxGeometry x="50" y="1070" width="200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d_record" value="Record visit date, diagnosis and notes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;" vertex="1" parent="laneD">
          <mxGeometry x="50" y="1150" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e01" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="r_start" target="r_login">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e02" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="r_login" target="r_search">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e03" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="r_search" target="r_select">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e04" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="r_select" target="r_submit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e05" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="r_submit" target="s_role">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e06" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="s_role" target="s_dec_role">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e07" value="[no]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="s_dec_role" target="s_403">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e08" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="s_403" target="s_denied">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e09" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="s_dec_role" target="s_active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="s_active" target="s_dec_active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="[no]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s_dec_active" target="r_refusal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="s_dec_active" target="s_slot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="s_slot" target="s_dec_slot">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e14" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s_dec_slot" target="r_refusal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e15" value="[no]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="s_dec_slot" target="s_save">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e16" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="s_save" target="s_dec_insert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e17" value="[no: a concurrent booking won]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="s_dec_insert" target="r_refusal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e18" value="[yes]" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s_dec_insert" target="d_list">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e19" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="r_refusal" target="r_adjust">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e20" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="r_adjust" target="r_select">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="60" y="705" />
              <mxPoint x="60" y="315" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e21" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="d_list" target="d_consult">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e22" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="d_consult" target="d_record">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d_record" target="s_complete">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e24" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="s_complete" target="s_end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e25" style="html=1;endArrow=none;dashed=1;" edge="1" parent="1" source="s_note" target="s_save">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
